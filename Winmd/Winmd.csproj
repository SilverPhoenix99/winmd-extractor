<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
      <PackageReference Include="Microsoft.Windows.SDK.Win32Metadata" Version="71.0.20-preview">
          <IncludeAssets>all</IncludeAssets>
          <GeneratePathProperty>true</GeneratePathProperty>
      </PackageReference>
      <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    </ItemGroup>

    <Target Name="CopyWindowsMetadata" AfterTargets="Build">
        <Copy SourceFiles="$(PKGMicrosoft_Windows_SDK_Win32Metadata)\Windows.Win32.winmd" DestinationFolder="$(OutputPath)" />
    </Target>

</Project>
